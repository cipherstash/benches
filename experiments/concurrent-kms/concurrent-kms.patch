+	// EXPERIMENT: perform a step's requests at the same time; the responses
+	// keep the requests' order.
+	type result struct {
+		status        int32
+		headers, body []byte
+	}
+	results := make([]result, len(step.requests))
+	var wg sync.WaitGroup
+	for i, r := range step.requests {
+		wg.Go(func() {
+			s, h, b := t.perform(ctx, r.method, r.url, r.headers, r.body)
+			results[i] = result{s, h, b}
+		})
+	}
+	wg.Wait()
+	for _, res := range results {
